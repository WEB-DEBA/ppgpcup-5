
<%
const playerList = Array.isArray(locals.players) ? locals.players : [];
const teamList = Array.isArray(locals.teams) ? locals.teams : [];
const matchList = Array.isArray(locals.matches) ? locals.matches : [];
const tableList = Array.isArray(locals.points) ? locals.points : [];
const noticeList = Array.isArray(locals.notices) ? locals.notices : [];

const pCount = Number(locals.playerCount ?? playerList.length) || 0;
const tCount = Number(locals.teamCount ?? teamList.length) || 0;
const mCount = Number(locals.matchCount ?? matchList.length) || 0;

const getTeamName = (team) => {
    if (typeof team === "string") return team;
    return team?.name || team?.teamName || team?.fullName || "TBA";
};
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PPGP CUP | Season 05</title>

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root {
    --bg:#070d0a;
    --panel:#101a13;
    --lime:#c7ff36;
    --green:#16a34a;
    --white:#f5f8f4;
    --muted:#9ba99e;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
    background:var(--bg);
    color:var(--white);
    font-family:Inter,sans-serif;
    overflow-x:hidden;
}
a{text-decoration:none;color:inherit}
.container{width:min(1160px,92%);margin:auto}

/* NAVBAR */
nav{
    height:76px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid #ffffff12;
}
.logo{
    font-family:'Barlow Condensed';
    font-size:29px;
    font-weight:900;
    line-height:.8;
}
.logo span{color:var(--lime)}
.logo small{
    display:block;
    font:700 9px Inter;
    letter-spacing:3px;
    color:#9aa99c;
    margin-top:8px;
}
.navlinks{display:flex;gap:27px;align-items:center;font-size:12px;color:#c5cec6}
.navlinks a:hover{color:var(--lime)}
.nav-btn{
    background:var(--lime);
    color:#10180b;
    padding:12px 19px;
    border-radius:5px;
    font-size:11px;
    font-weight:900;
}

/* HERO */
.hero{
    min-height:510px;
    display:grid;
    grid-template-columns:1.05fr .95fr;
    align-items:center;
    gap:25px;
    padding:45px 0 35px;
}
.tag{
    color:var(--lime);
    font-size:10px;
    font-weight:900;
    letter-spacing:3px;
    display:flex;
    align-items:center;
    gap:10px;
}
.tag:before{content:"";width:25px;height:2px;background:var(--lime)}
.hero h1{
    font-family:'Barlow Condensed';
    font-size:clamp(65px,9vw,115px);
    line-height:.82;
    font-weight:900;
    margin:22px 0;
    letter-spacing:-2px;
}
.hero h1 span{
    color:var(--lime);
    display:block;
    text-shadow:0 0 35px #c7ff3633;
}
.hero p{
    max-width:460px;
    color:#a8b5aa;
    font-size:13px;
    line-height:1.9;
}
.hero-actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
.primary{
    background:var(--lime);
    color:#10180b;
    padding:15px 23px;
    border-radius:4px;
    font-size:11px;
    font-weight:900;
}
.secondary{
    border:1px solid #ffffff35;
    padding:15px 23px;
    border-radius:4px;
    font-size:11px;
    font-weight:800;
}
.hero-meta{
    margin-top:35px;
    display:flex;
    gap:25px;
    color:#829087;
    font-size:10px;
    letter-spacing:1px;
}
.hero-meta b{color:white}

/* 3D STADIUM */
.stadium{
    height:390px;
    position:relative;
    border-radius:14px;
    overflow:hidden;
    background:
      linear-gradient(0deg,#07120a 0%,transparent 60%),
      linear-gradient(135deg,#162b1b,#07100c 65%);
    border:1px solid #ffffff1c;
    box-shadow:0 25px 80px #0009;
}
.stadium:before{
    content:"";
    position:absolute;
    inset:0;
    background:
      radial-gradient(ellipse at 50% 80%,#3f9d3b55,transparent 55%),
      repeating-linear-gradient(90deg,transparent 0 49px,#ffffff08 50px);
}
.stadium-img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    opacity:.35;
}
.stadium-label{
    position:absolute;
    top:22px;
    left:22px;
    font-size:10px;
    letter-spacing:2px;
    font-weight:900;
    color:var(--lime);
}
.ground{
    position:absolute;
    width:75%;
    height:150px;
    left:12%;
    bottom:20px;
    border-radius:50%;
    transform:perspective(300px) rotateX(55deg);
    background:repeating-linear-gradient(90deg,#245c2b 0 25px,#327b35 26px 50px);
    border:3px solid #b7e9a0;
    box-shadow:0 0 35px #5cff5140;
}
.pitch{
    position:absolute;
    width:25%;
    height:55px;
    left:37%;
    bottom:65px;
    background:#b3a16c;
    transform:perspective(200px) rotateX(55deg);
    border:2px solid #e2d39a;
}
.ball{
    position:absolute;
    width:75px;
    height:75px;
    right:17%;
    top:27%;
    border-radius:50%;
    background:radial-gradient(circle at 30% 25%,#fff4a4,#e9ff3d 25%,#86ae0d 70%,#304600);
    box-shadow:0 0 30px #c7ff3677, inset -9px -10px 15px #263700;
    animation:float 3s ease-in-out infinite;
}
.ball:after{
    content:"";
    position:absolute;
    width:2px;
    height:65px;
    background:#ffffffa0;
    left:35px;
    top:5px;
    transform:rotate(35deg);
}
.bat{
    position:absolute;
    width:29px;
    height:190px;
    left:23%;
    top:25%;
    background:linear-gradient(90deg,#75401b,#e6a75e,#8b4d20);
    border-radius:40% 40% 12px 12px;
    transform:rotate(32deg);
    box-shadow:8px 10px 22px #0009;
}
.bat:after{
    content:"";
    position:absolute;
    height:75px;
    width:12px;
    background:#282019;
    bottom:-65px;
    left:8px;
    border-radius:8px;
}
@keyframes float{
    0%,100%{transform:translateY(0) rotate(0)}
    50%{transform:translateY(-17px) rotate(15deg)}
}
.stadium-bottom{
    position:absolute;
    bottom:17px;
    left:22px;
    right:22px;
    display:flex;
    justify-content:space-between;
    font-size:10px;
    letter-spacing:1px;
    color:white;
}

/* STATS */
.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    background:#111b13;
    border:1px solid #ffffff12;
    border-radius:9px;
    margin:12px 0 55px;
}
.stat{
    padding:21px;
    border-right:1px solid #ffffff12;
    text-align:center;
}
.stat:last-child{border:0}
.stat h2{
    font-family:'Barlow Condensed';
    font-size:35px;
    color:var(--lime);
}
.stat p{font-size:9px;color:#9ca99e;letter-spacing:1.5px;margin-top:3px}

/* SECTION */
.section-head{
    display:flex;
    align-items:end;
    justify-content:space-between;
    margin-bottom:20px;
}
.section-head h2{
    font:900 38px 'Barlow Condensed';
    text-transform:uppercase;
}
.section-head h2 span{color:var(--lime)}
.section-head p{font-size:11px;color:#87958a}

/* TEAMS */
.team-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}
.team-card{
    background:linear-gradient(145deg,#17251a,#0c130e);
    border:1px solid #ffffff13;
    border-radius:9px;
    padding:20px;
    transition:.3s;
}
.team-card:hover{
    transform:translateY(-5px);
    border-color:#c7ff3666;
}
.team-logo{
    width:55px;height:55px;
    object-fit:contain;
    margin-bottom:15px;
}
.team-placeholder{
    width:55px;height:55px;
    border-radius:50%;
    display:grid;place-items:center;
    background:#c7ff3618;
    color:var(--lime);
    font-size:24px;
    margin-bottom:15px;
}
.team-card h3{font-size:15px;margin-bottom:7px}
.team-card p{font-size:10px;color:#9eaa9f}

/* STORY */
.story{
    margin:60px 0;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    align-items:center;
    background:#101a13;
    padding:22px;
    border-radius:12px;
    border:1px solid #ffffff12;
}
.story img{
    width:100%;
    height:250px;
    object-fit:cover;
    border-radius:8px;
}
.story h2{
    font:900 42px 'Barlow Condensed';
    margin:12px 0;
}
.story h2 span{color:var(--lime)}
.story p{color:#a3b0a5;font-size:12px;line-height:1.9}
.story-points{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.story-points span{
    border:1px solid #ffffff20;
    padding:9px 12px;
    border-radius:4px;
    font-size:9px;
    color:var(--lime);
    font-weight:800;
}

/* GALLERY */
.gallery{margin-bottom:55px}
.gallery-grid{
    display:grid;
    grid-template-columns:1.3fr 1fr 1fr;
    gap:13px;
}
.gallery-card{
    height:205px;
    position:relative;
    overflow:hidden;
    border-radius:8px;
    background:#17251a;
}
.gallery-card img{
    width:100%;height:100%;object-fit:cover;
    transition:.5s;
}
.gallery-card:hover img{transform:scale(1.08)}
.gallery-card:after{
    content:"";
    position:absolute;inset:0;
    background:linear-gradient(0deg,#000b,transparent 70%);
}
.gallery-card h3{
    position:absolute;
    z-index:2;
    bottom:17px;left:16px;
    font:800 23px 'Barlow Condensed';
}

/* PLAYERS */
.player-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:13px;
}
.player-card{
    background:#111b13;
    border:1px solid #ffffff12;
    border-radius:8px;
    overflow:hidden;
}
.player-card img{
    width:100%;height:155px;object-fit:cover;
    background:#1d3020;
}
.player-info{padding:13px}
.player-info h3{font-size:12px;margin-bottom:5px}
.player-info p{font-size:10px;color:#9eaa9f}

/* CTA */
.cta{
    margin:60px 0 35px;
    text-align:center;
    padding:40px 20px;
    border-radius:12px;
    background:
      radial-gradient(ellipse at center,#294b1b,#101b12 70%);
    border:1px solid #c7ff3630;
}
.cta h2{
    font:900 48px 'Barlow Condensed';
    margin-bottom:8px;
}
.cta h2 span{color:var(--lime)}
.cta p{font-size:12px;color:#b1bdb2;margin-bottom:22px}

/* FOOTER */
footer{
    border-top:1px solid #ffffff15;
    padding:23px 0;
    color:#849187;
    font-size:10px;
}
.footer-inner{
    display:flex;
    justify-content:space-between;
    gap:15px;
    flex-wrap:wrap;
}
footer b{color:var(--lime)}

@media(max-width:800px){
    .navlinks{gap:12px;font-size:10px}
    .nav-btn{display:none}
    .hero{grid-template-columns:1fr;padding-top:35px}
    .stadium{height:300px}
    .team-grid{grid-template-columns:repeat(2,1fr)}
    .player-grid{grid-template-columns:repeat(2,1fr)}
    .story{grid-template-columns:1fr}
}
@media(max-width:520px){
    nav{height:65px}
    .navlinks{gap:10px}
    .navlinks a{font-size:9px}
    .hero h1{font-size:76px}
    .hero-meta{gap:12px;font-size:8px}
    .stats{grid-template-columns:repeat(2,1fr)}
    .stat:nth-child(2){border-right:0}
    .stat:nth-child(-n+2){border-bottom:1px solid #ffffff12}
    .section-head h2{font-size:30px}
    .section-head p{display:none}
    .gallery-grid{grid-template-columns:1fr 1fr}
    .gallery-card{height:145px}
    .gallery-card:first-child{grid-column:span 2}
    .team-grid{gap:9px}
    .team-card{padding:14px}
    .story{padding:14px}
    .story h2{font-size:35px}
    .cta h2{font-size:38px}
}
</style>
</head>

<body>

<div class="container">

<nav>
    <a href="/" class="logo">PPGP <span>CUP.</span><small>SEASON 05 · 2026</small></a>
    <div class="navlinks">
        <a href="/">HOME</a>
        <a href="/teams">TEAMS</a>
        <a href="/players">PLAYERS</a>
        <a href="/matches">MATCHES</a>
    </div>
    <a href="/register" class="nav-btn">JOIN TOURNAMENT ↗</a>
</nav>

<section class="hero">
    <div>
        <div class="tag">KENDRAPARA · ODISHA</div>
        <h1>THE GAME.<span>THE GLORY.</span></h1>
        <p>
            Welcome to PPGP CUP Season 05 — a celebration of tennis cricket,
            local talent, team spirit and unforgettable sporting moments.
            One ground, many teams, one champion.
        </p>
        <div class="hero-actions">
            <a href="/teams" class="primary">EXPLORE TEAMS ↗</a>
            <a href="/register" class="secondary">PLAYER REGISTRATION</a>
        </div>
        <div class="hero-meta">
            <span><b>SEASON</b> 05</span>
            <span><b>LOCATION</b> ODISHA</span>
            <span><b>SPORT</b> TENNIS CRICKET</span>
        </div>
    </div>

    <div class="stadium">
        <img class="stadium-img"
        src="https://images.unsplash.com/photo-1508098682722-e99c643e7f0b?auto=format&fit=crop&w=1000&q=85"
        alt="Cricket stadium">
        <div class="stadium-label">PPGP CUP · THE BATTLEFIELD</div>
        <div class="bat"></div>
        <div class="ball"></div>
        <div class="ground"></div>
        <div class="pitch"></div>
        <div class="stadium-bottom">
            <b>KENDRAPARA, ODISHA</b>
            <b>SEASON 05 / 2026</b>
        </div>
    </div>
</section>

<section class="stats">
    <div class="stat"><h2><%= tCount %></h2><p>REGISTERED TEAMS</p></div>
    <div class="stat"><h2><%= pCount %></h2><p>PLAYERS</p></div>
    <div class="stat"><h2><%= mCount %></h2><p>MATCHES</p></div>
    <div class="stat"><h2>05</h2><p>TOURNAMENT SEASON</p></div>
</section>

<section>
    <div class="section-head">
        <div>
            <div class="tag">THE COMPETITORS</div>
            <h2>OUR <span>TEAMS</span></h2>
        </div>
        <a href="/teams" class="secondary">VIEW ALL ↗</a>
    </div>

    <div class="team-grid">
        <% if(teamList.length){ %>
            <% teamList.slice(0,6).forEach(team => { %>
                <div class="team-card">
                    <% if(team.logo){ %>
                        <img class="team-logo" src="<%= team.logo %>" alt="Team logo">
                    <% } else { %>
                        <div class="team-placeholder">🏏</div>
                    <% } %>
                    <h3><%= getTeamName(team) %></h3>
                    <p>CAPTAIN: <%= team.captain || "To be announced" %></p>
                </div>
            <% }) %>
        <% } else { %>
            <div class="team-card">
                <div class="team-placeholder">🏆</div>
                <h3>Teams Coming Soon</h3>
                <p>Team information will appear here.</p>
            </div>
        <% } %>
    </div>
</section>

<section class="story">
    <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?auto=format&fit=crop&w=900&q=85"
         alt="Cricket match in a stadium">
    <div>
        <div class="tag">MORE THAN A GAME</div>
        <h2>ODISHA'S <span>TENNIS CRICKET</span> SPIRIT.</h2>
        <p>
            Tennis cricket brings communities together through passion,
            teamwork and exciting competition. PPGP CUP celebrates the
            players, teams and cricket lovers of Kendrapara and Odisha.
            Every match is a new opportunity to perform, compete and make memories.
        </p>
        <div class="story-points">
            <span>TEAM SPIRIT</span>
            <span>LOCAL TALENT</span>
            <span>SPORTSMANSHIP</span>
        </div>
    </div>
</section>

<section class="gallery">
    <div class="section-head">
        <div>
            <div class="tag">FEEL THE ENERGY</div>
            <h2>GAME <span>ON.</span></h2>
        </div>
        <p>PASSION · POWER · PERFORMANCE</p>
    </div>

    <div class="gallery-grid">
        <div class="gallery-card">
            <img src="https://images.unsplash.com/photo-1531415074968-036ba1b575da?auto=format&fit=crop&w=900&q=85" alt="Cricket ground">
            <h3>THE BIG STAGE</h3>
        </div>
        <div class="gallery-card">
            <img src="https://images.unsplash.com/photo-1593766827228-8737b2cd0646?auto=format&fit=crop&w=700&q=85" alt="Cricket player batting">
            <h3>PURE ACTION</h3>
        </div>
        <div class="gallery-card">
            <img src="https://images.unsplash.com/photo-1566577739112-5180d4bf9390?auto=format&fit=crop&w=700&q=85" alt="Sports stadium">
            <h3>TEAM PRIDE</h3>
        </div>
    </div>
</section>

<section>
    <div class="section-head">
        <div>
            <div class="tag">THE TALENT</div>
            <h2>FEATURED <span>PLAYERS</span></h2>
        </div>
        <a href="/players" class="secondary">ALL PLAYERS ↗</a>
    </div>

    <div class="player-grid">
        <% if(playerList.length){ %>
            <% playerList.slice(0,4).forEach(player => { %>
                <div class="player-card">
                    <% if(player.playerPhoto){ %>
                        <img src="/player-photos/<%= encodeURIComponent(player.playerPhoto) %>" alt="<%= player.fullName || 'Player' %>">
                    <% } else { %>
                        <img src="https://images.unsplash.com/photo-1531415074968-036ba1b575da?auto=format&fit=crop&w=500&q=75" alt="Player">
                    <% } %>
                    <div class="player-info">
                        <h3><%= player.fullName || "Player" %></h3>
                        <p><%= player.role || "Cricket Player" %> · <%= player.city || player.district || "Odisha" %></p>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="team-card">
                <h3>Players Coming Soon</h3>
                <p>Registered player profiles will appear here.</p>
            </div>
        <% } %>
    </div>
</section>

<section class="cta">
    <div class="tag" style="justify-content:center">YOUR MOMENT STARTS HERE</div>
    <h2>READY TO <span>PLAY?</span></h2>
    <p>Be part of the excitement. Explore the tournament and register today.</p>
    <a href="/register" class="primary">REGISTER NOW ↗</a>
</section>

<footer>
    <div class="footer-inner">
        <div><b>PPGP CUP.</b> · SEASON 05 · KENDRAPARA, ODISHA</div>
        <div>© 2026 PPGP CUP. ALL RIGHTS RESERVED.</div>
    </div>
</footer>

</div>
</body>
</html>
