
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Players | PPGP CUP Season 5</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root {
    --bg: #07120e;
    --panel: #101f18;
    --lime: #c7ff45;
    --muted: #9aab9f;
    --line: rgba(255,255,255,.09);
}
* { box-sizing: border-box; }
body {
    margin: 0;
    background: radial-gradient(ellipse at 50% -20%, #23452e 0%, var(--bg) 55%);
    color: #f5fff7;
    font-family: Inter, sans-serif;
    min-height: 100vh;
}
header {
    padding: 22px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
}
.logo { font-weight: 900; letter-spacing: 1px; font-size: 21px; }
.logo span { color: var(--lime); }
nav a {
    color: #dce9df;
    text-decoration: none;
    margin-left: 24px;
    font-size: 13px;
    font-weight: 700;
}
nav a:hover { color: var(--lime); }
.container { width: min(1180px, 90%); margin: auto; }
.hero { padding: 65px 0 35px; }
.eyebrow {
    color: var(--lime);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
}
h1 {
    font-size: clamp(38px, 7vw, 70px);
    margin: 13px 0;
    letter-spacing: -3px;
}
h1 span { color: var(--lime); }
.subtitle { color: var(--muted); line-height: 1.7; }
.stats {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    background: rgba(199,255,69,.08);
    border: 1px solid rgba(199,255,69,.2);
    padding: 13px 18px;
    border-radius: 14px;
    margin-top: 22px;
}
.stats strong { color: var(--lime); font-size: 23px; }
.stats small { color: #c7d5ca; }
.filters {
    display: grid;
    grid-template-columns: 1fr 240px auto;
    gap: 12px;
    margin: 25px 0 30px;
}
.filters input, .filters select {
    width: 100%;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #102119;
    color: white;
    outline: none;
    font: inherit;
}
.filters input:focus, .filters select:focus { border-color: var(--lime); }
.filters button, .register-btn {
    border: 0;
    border-radius: 12px;
    background: var(--lime);
    color: #10200e;
    font-weight: 900;
    padding: 0 25px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.filters button:hover, .register-btn:hover { background: #dcff88; }
.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin: 35px 0 20px;
}
.section-heading h2 { font-size: 23px; margin: 0; }
.section-heading span { color: var(--muted); font-size: 13px; }
.player-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 19px;
    padding-bottom: 70px;
}
.player-card {
    background: linear-gradient(145deg, #14271c, #0d1a14);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 19px;
    position: relative;
    overflow: hidden;
    transition: .25s ease;
}
.player-card:hover {
    transform: translateY(-6px);
    border-color: rgba(199,255,69,.55);
    box-shadow: 0 18px 45px rgba(0,0,0,.25);
}
.player-top { display: flex; gap: 15px; align-items: center; }
.avatar {
    width: 76px;
    height: 76px;
    border-radius: 17px;
    object-fit: cover;
    background: #263c2c;
    border: 1px solid rgba(199,255,69,.3);
}
.initial {
    width: 76px;
    height: 76px;
    border-radius: 17px;
    display: grid;
    place-items: center;
    background: #263c2c;
    color: var(--lime);
    font-size: 30px;
    font-weight: 900;
}
.player-name { font-size: 17px; font-weight: 900; margin-bottom: 7px; }
.player-location { color: var(--muted); font-size: 12px; }
.role {
    display: inline-block;
    margin-top: 9px;
    padding: 6px 10px;
    border-radius: 20px;
    background: rgba(199,255,69,.1);
    color: var(--lime);
    font-size: 10px;
    font-weight: 900;
}
.jersey {
    position: absolute;
    right: 17px;
    top: 17px;
    color: rgba(255,255,255,.13);
    font-size: 30px;
    font-weight: 900;
}
.details {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 15px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
}
.detail small {
    display: block;
    color: var(--muted);
    font-size: 10px;
    margin-bottom: 5px;
}
.detail strong { font-size: 12px; }
.empty {
    grid-column: 1/-1;
    text-align: center;
    padding: 65px 15px;
    border: 1px dashed #52675a;
    border-radius: 18px;
    color: var(--muted);
}
.empty strong {
    display: block;
    color: white;
    font-size: 20px;
    margin-bottom: 10px;
}
footer {
    border-top: 1px solid var(--line);
    padding: 25px;
    text-align: center;
    color: var(--muted);
    font-size: 12px;
}
@media(max-width:800px) {
    .player-grid { grid-template-columns: repeat(2, 1fr); }
    .filters { grid-template-columns: 1fr 1fr; }
    .filters button { min-height: 48px; grid-column: 1/-1; }
}
@media(max-width:560px) {
    header { padding: 18px 5%; }
    nav a { margin-left: 12px; font-size: 11px; }
    .container { width: 90%; }
    .hero { padding-top: 45px; }
    .player-grid { grid-template-columns: 1fr; }
    .filters { grid-template-columns: 1fr; }
    .filters button { grid-column: auto; }
    h1 { letter-spacing: -2px; }
}
</style>
</head>

<body>

<header>
    <div class="logo">PPGP <span>CUP.</span></div>
    <nav>
        <a href="/">HOME</a>
        <a href="/register">REGISTER</a>
        <a href="/players">PLAYERS</a>
    </nav>
</header>

<main class="container">

    <section class="hero">
        <div class="eyebrow">Season 05 • Odisha Tennis Cricket</div>
        <h1>MEET THE <span>PLAYERS.</span></h1>
        <p class="subtitle">
            Every player. Every role. One tournament.<br>
            Discover the athletes competing in PPGP CUP Season 5.
        </p>

        <div class="stats">
            <strong><%= typeof totalPlayers !== "undefined" ? totalPlayers : players.length %></strong>
            <small>REGISTERED PLAYERS</small>
        </div>
    </section>

    <form class="filters" action="/players" method="GET">
        <input
            type="search"
            name="q"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            placeholder="Search player, city or district..."
        >

        <select name="role">
            <option value="">All Roles</option>
            <option value="Batsman" <%= typeof selectedRole !== 'undefined' && selectedRole === "Batsman" ? "selected" : "" %>>Batsman</option>
            <option value="Bowler" <%= typeof selectedRole !== 'undefined' && selectedRole === "Bowler" ? "selected" : "" %>>Bowler</option>
            <option value="All-Rounder" <%= typeof selectedRole !== 'undefined' && selectedRole === "All-Rounder" ? "selected" : "" %>>All-Rounder</option>
            <option value="Wicket Keeper" <%= typeof selectedRole !== 'undefined' && selectedRole === "Wicket Keeper" ? "selected" : "" %>>Wicket Keeper</option>
        </select>

        <button type="submit">FIND PLAYERS ↗</button>
    </form>

    <div class="section-heading">
        <h2>PLAYER ROSTER</h2>
        <span><%= players.length %> player(s) found</span>
    </div>

    <section class="player-grid">

        <% if (players.length > 0) { %>

            <% players.forEach(player => { %>

                <article class="player-card">

                    <div class="jersey">
                        <%= player.jerseyNumber !== null && player.jerseyNumber !== undefined ? "#" + player.jerseyNumber : "★" %>
                    </div>

                    <div class="player-top">

                        <% if (player.playerPhoto) { %>
                            <img
                                class="avatar"
                                src="/player-photos/<%= encodeURIComponent(player.playerPhoto) %>"
                                alt="<%= player.fullName || 'Player' %>"
                                onerror="this.style.display='none'"
                            >
                        <% } else { %>
                            <div class="initial">
                                <%= (player.fullName || "P").charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                        <div>
                            <div class="player-name"><%= player.fullName || "Unknown Player" %></div>

                            <div class="player-location">
                                <%= player.city || "City not specified" %>,
                                <%= player.district || "District not specified" %>
                            </div>

                            <span class="role"><%= player.role || "Player" %></span>
                        </div>

                    </div>

                    <div class="details">

                        <div class="detail">
                            <small>BATTING STYLE</small>
                            <strong><%= player.battingStyle || "Not specified" %></strong>
                        </div>

                        <div class="detail">
                            <small>BOWLING STYLE</small>
                            <strong><%= player.bowlingStyle || "Not specified" %></strong>
                        </div>

                        <div class="detail">
                            <small>TEAM</small>
                            <strong><%= player.teamName || "Not assigned" %></strong>
                        </div>

                        <div class="detail">
                            <small>JERSEY NUMBER</small>
                            <strong><%= player.jerseyNumber ?? "—" %></strong>
                        </div>

                    </div>

                </article>

            <% }); %>

        <% } else { %>

            <div class="empty">
                <strong>No players found</strong>
                Try another name or role filter, or register as the first player.
                <p><a class="register-btn" href="/register">REGISTER NOW</a></p>
            </div>

        <% } %>

    </section>

</main>

<footer>
    © <%= new Date().getFullYear() %> PPGP CUP Season 5 • Odisha Tennis Cricket
</footer>

</body>
</html>
